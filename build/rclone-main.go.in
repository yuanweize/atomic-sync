// Atomic Sync ships a deliberately narrow rclone CLI. Only the local,
// Google Drive, and crypt backends, plus commands exercised by the engine,
// are linked.
// This reduces the runtime attack surface without changing rclone semantics
// for the supported StorageBox-to-GD deployment.
package main

import (
	_ "github.com/rclone/rclone/backend/crypt"
	_ "github.com/rclone/rclone/backend/drive"
	_ "github.com/rclone/rclone/backend/local"
	"github.com/rclone/rclone/cmd"
	_ "github.com/rclone/rclone/cmd/check"
	_ "github.com/rclone/rclone/cmd/copy"
	_ "github.com/rclone/rclone/cmd/lsf"
	_ "github.com/rclone/rclone/cmd/lsjson"
	_ "github.com/rclone/rclone/cmd/move"
	_ "github.com/rclone/rclone/cmd/version"
)

func main() {
	cmd.Main()
}
